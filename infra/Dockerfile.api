# syntax=docker/dockerfile:1

###############################################################################
# LEARN API — NestJS bundle qua tsup.
# Build từ repo root:  docker build -f infra/Dockerfile.api -t learn-api .
# NOTA: chưa kiểm chứng bằng thật vì máy dev không có Docker (xem docs/progress).
###############################################################################

ARG NODE_VERSION=22

# ---- Builder: cài đủ deps (kể cả dev) + build ---------------------------------
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app

# Chỉ copy manifest trước để tận dụng layer cache của npm.
# npm workspaces yêu cầu đủ package.json của mọi workspace có mặt trong lockfile.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/ui/package.json packages/ui/package.json
# Schema Prisma phải nằm trong context lúc `npm ci` (postinstall chạy `prisma generate`).
COPY packages/db/prisma packages/db/prisma

RUN npm ci

COPY . .

RUN npm run build -w apps/api

# ---- Runtime: chỉ prod deps cho apps/api --------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/ui/package.json packages/ui/package.json

# --ignore-scripts: postinstall (`prisma generate`) không cần — client đã generate
# ở builder và được copy xuống. Tránh npm chạy script lúc install rồi fail vì thiếu prisma CLI.
RUN npm ci --omit=dev --ignore-scripts -w apps/api

# Prisma client đã generate (engine + client) — copy từ builder, KHÔNG generate lại lúc runtime.
COPY --from=builder /app/node_modules/.prisma node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client node_modules/@prisma/client
# Bundle tsup (apps/api/dist/main.js) — phụ thuộc @learn/* và native (@node-rs/argon2) đã có trong node_modules.
COPY --from=builder /app/apps/api/dist apps/api/dist

USER node
EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]