# ─── Học tập ────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Dùng chung cho CORS/link email (api) và sitemap/robots/OG (web) — web app chưa
# tự đọc file .env ở gốc repo (Next.js chỉ đọc .env trong apps/web/), nên khi
# deploy thật hãy set biến này ở nơi web app thực sự đọc được (env của nền tảng
# deploy, hoặc apps/web/.env).
APP_URL=http://localhost:3000
# Múi giờ cắt "ngày" cho chuỗi học liên tiếp (tên IANA). Mặc định giờ Việt Nam.
APP_TIMEZONE=Asia/Ho_Chi_Minh
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://learn:learn@localhost:5432/learn?schema=public

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Object Storage (MinIO khi dev) ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=learn-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_PUT_URL_EXPIRES_SEC=900

# ─── LLM ───────────────────────────────────────────────────────────────
# anthropic → Claude; google → Gemini (Google AI Studio); openai → GPT hoặc nhà cung cấp tương thích
# Chat Completions (đặt LLM_BASE_URL). Model phải cùng họ với provider.
#   anthropic: LLM_MODEL_GENERATION=claude-sonnet-5      LLM_MODEL_FAST=claude-haiku-4-5-20251001
#   google   : LLM_MODEL_GENERATION=gemini-3.1-flash-lite  LLM_MODEL_FAST=gemini-3.1-flash-lite
#              (gemini-3.5-flash-lite từng chậm tới 150s/lời gọi — đừng dùng làm dự phòng, ADR 009)
#   openai   : LLM_MODEL_GENERATION=gpt-6-luna  LLM_MODEL_FALLBACK=gpt-5-nano  LLM_REASONING_EFFORT=low (ADR 010)
LLM_PROVIDER=anthropic
# Tuỳ chọn, chỉ cho openai: endpoint tương thích (vd https://api.deepseek.com/v1). Trống = OpenAI.
LLM_BASE_URL=
# Tuỳ chọn, chỉ cho model reasoning qua openai: none|minimal|low|medium|high. Trống = mặc định model.
LLM_REASONING_EFFORT=
LLM_API_KEY=
LLM_MODEL_GENERATION=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# Tuỳ chọn — model cùng provider, tự chuyển sang khi model chính trả 429/503/529 (ADR 009).
# Để trống = không dự phòng. Ví dụ google: gemini-3.1-flash-lite; anthropic: claude-haiku-4-5.
LLM_MODEL_FALLBACK=
# mock = không gọi mạng (mặc định). live = gọi thật, cần LLM_API_KEY.
# ⚠️ Worker đọc .env trong apps/worker/, KHÔNG đọc file này — đặt key cho LLM ở đó.
LLM_MODE=mock
# Tuỳ chọn — kịch bản sẵn cho MockLlmProvider (title/nội dung/bài tập chuẩn bị trước cho demo).
# Xem packages/ai/src/llm/fixtures.ts và apps/worker/fixtures/lessons.example.json.
MOCK_FIXTURES_PATH=
AI_JOB_MAX_COST_USD=0.50
AI_JOB_TIMEOUT_MS=900000
AI_MAX_CONCURRENT_CALLS=3

# ─── Upload limits ──────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=26214400
DOCUMENT_MAX_SIZE=26214400
UPLOAD_MAX_PAGES=300
OCR_MAX_PAGES=50

# ─── Billing ────────────────────────────────────────────────────────────
BILLING_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=