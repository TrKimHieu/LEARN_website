// Prisma schema LEARN — phiên bản 1, phản chiếu HANDBOOK §6.2.
// id: String + @default(uuid()) là mặc định ở tầng DB; ứng dụng luôn cấp id uuidv7
// qua `newId()` ở packages/db để đạt thứ tự sắp xếp theo thời gian mà không cần db gen.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Người dùng và phiên ────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  role            UserRole  @default(LEARNER)
  locale          String    @default("vi")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  subscriptions       Subscription[]
  courses             Course[]
  documents           Document[]
  aiJobs              AIJob[]
  progress            LearningProgress[]
  submissions         Submission[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  usage               UsageCounter[]
  auditLogs           AuditLog[]
}

enum UserRole {
  LEARNER
  ADMIN
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

/// Đặt lại mật khẩu qua email (FR-AUTH-07). Chỉ lưu SHA-256 của token, dùng một lần, hạn ngắn.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Khóa học và tài liệu ───────────────────────────────────────────

model Course {
  id          String       @id @default(uuid())
  ownerId     String
  title       String
  description String?
  language    String       @default("vi")
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  owner     User               @relation(fields: [ownerId], references: [id])
  documents Document[]
  lessons   Lesson[]
  aiJobs    AIJob[]
  progress  LearningProgress[]

  @@index([ownerId, deletedAt, updatedAt])
}

enum CourseStatus {
  DRAFT
  READY
  ARCHIVED
}

model Document {
  id             String         @id @default(uuid())
  courseId       String
  uploaderId     String
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String         @unique
  checksumSha256 String
  pageCount      Int?
  status         DocumentStatus @default(PENDING)
  errorCode      String?
  errorMessage   String?
  extractedAt    DateTime?
  createdAt      DateTime       @default(now())

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader User            @relation(fields: [uploaderId], references: [id])
  chunks   DocumentChunk[]
  aiJobs   AIJob[]

  @@index([courseId, status])
  @@index([courseId, checksumSha256])
}

enum DocumentStatus {
  PENDING
  UPLOADED
  EXTRACTING
  EXTRACTED
  FAILED
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  index       Int
  content     String   @db.Text
  tokenCount  Int
  pageFrom    Int?
  pageTo      Int?
  headingPath String?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([documentId])
}

// ─── AI ─────────────────────────────────────────────────────────────

model AIJob {
  id             String      @id @default(uuid())
  courseId       String
  documentId     String?
  requestedById  String
  type           AIJobType
  status         AIJobStatus @default(QUEUED)
  progress       Int         @default(0)
  progressLabel  String?
  attempt        Int         @default(0)
  idempotencyKey String      @unique
  inputParams    Json
  error          Json?
  queuedAt       DateTime    @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  document  Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  requester User            @relation(fields: [requestedById], references: [id])
  runs      GenerationRun[]

  @@index([courseId, status])
  @@index([status, queuedAt])
}

enum AIJobType {
  EXTRACT_DOCUMENT
  GENERATE_LESSONS
  REGENERATE_LESSON
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model GenerationRun {
  id               String   @id @default(uuid())
  aiJobId          String
  step             String
  model            String
  promptVersion    String
  inputTokens      Int
  outputTokens     Int
  costUsd          Decimal  @db.Decimal(10, 6)
  latencyMs        Int
  attempt          Int      @default(1)
  rawResponseKey   String?
  validationReport Json?
  createdAt        DateTime @default(now())

  aiJob AIJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@index([aiJobId])
  @@index([createdAt])
}

// ─── Nội dung học ───────────────────────────────────────────────────

model Lesson {
  id               String           @id @default(uuid())
  courseId         String
  documentId       String?
  aiJobId          String?
  orderIndex       Int
  title            String
  summary          String?
  contentMd        String           @db.Text
  estimatedMinutes Int?
  status           LessonStatus     @default(DRAFT)
  sourceChunkIds   String[]
  confidence       LessonConfidence @default(UNKNOWN)
  editedByUserAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@unique([courseId, orderIndex])
  @@index([courseId, status])
}

enum LessonConfidence {
  UNKNOWN
  HIGH
  LOW
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

model Exercise {
  id          String     @id @default(uuid())
  lessonId    String
  orderIndex  Int
  title       String?
  instruction String?
  difficulty  Difficulty @default(MEDIUM)
  passScore   Int        @default(70)
  createdAt   DateTime   @default(now())

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]

  @@unique([lessonId, orderIndex])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id            String       @id @default(uuid())
  exerciseId    String
  orderIndex    Int
  type          QuestionType
  prompt        String       @db.Text
  explanation   String?      @db.Text
  correctAnswer Json
  points        Int          @default(1)
  sourceChunkId String?
  createdAt     DateTime     @default(now())

  exercise          Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  options           AnswerOption[]
  submissionAnswers SubmissionAnswer[]

  @@unique([exerciseId, orderIndex])
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  FILL_BLANK
}

model AnswerOption {
  id         String  @id @default(uuid())
  questionId String
  orderIndex Int
  label      String
  content    String
  isCorrect  Boolean

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderIndex])
}

// ─── Tiến trình học ─────────────────────────────────────────────────

model LearningProgress {
  id          String         @id @default(uuid())
  userId      String
  courseId    String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  bestScore   Int?
  attempts    Int            @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Submission {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  attemptNo  Int
  score      Int
  maxScore   Int
  durationMs Int?
  createdAt  DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answers  SubmissionAnswer[]

  @@unique([userId, exerciseId, attemptNo])
  @@index([userId, createdAt])
}

model SubmissionAnswer {
  id           String  @id @default(uuid())
  submissionId String
  questionId   String
  rawAnswer    Json
  isCorrect    Boolean
  pointsEarned Int
  feedback     String?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

// ─── Gói dịch vụ và thanh toán ──────────────────────────────────────

model Plan {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  priceCents        Int
  currency          String   @default("USD")
  interval          String   @default("month")
  limits            Json
  features          String[]
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  isFutureExtension Boolean  @default(false)
  providerPriceId   String?

  subscriptions Subscription[]

  @@index([isActive, displayOrder])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Payment {
  id                String    @id @default(uuid())
  subscriptionId    String
  amountCents       Int
  currency          String
  status            String
  providerPaymentId String    @unique
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id           String    @id @default(uuid())
  provider     String
  eventId      String
  type         String
  payload      Json
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  processError String?

  @@unique([provider, eventId])
}

model UsageCounter {
  id     String      @id @default(uuid())
  userId String
  period String
  metric UsageMetric
  value  Int         @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, metric])
}

enum UsageMetric {
  COURSES_CREATED
  DOCUMENTS_UPLOADED
  PAGES_PROCESSED
  AI_JOBS_RUN
  LLM_TOKENS
}

// ─── Vận hành ───────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ─── Roadmap — tạo bảng trước, chưa dùng ở MVP ──────────────────────

model CourseMember {
  id       String           @id @default(uuid())
  courseId String
  userId   String
  role     CourseMemberRole @default(VIEWER)
  addedAt  DateTime         @default(now())

  @@unique([courseId, userId])
}

enum CourseMemberRole {
  OWNER
  EDITOR
  VIEWER
}
